# RepoReady Environment Configuration Example
# Copy this file to .env and configure your values.

# GitHub Personal Access Token (optional, raises rate limit from 60 to 5,000 req/hr)
# Generate at: https://github.com/settings/tokens (no extra scopes required for public repos)
GITHUB_TOKEN=your_github_personal_access_token_here

# Local Ollama AI Server Configuration (optional, defaults to local daemon)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
